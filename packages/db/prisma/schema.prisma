generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Book {
  title        String
  author       String?
  description  String?
  bookCoverUrl String?  @map("book_cover_url")
  filePath     String?  @map("file_path")
  rating       Float?   @db.Real
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  uploadedBy   String   @map("uploaded_by") @db.Uuid
  clubId       String   @map("club_id") @db.Uuid

  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  session    Session    @relation("books_session_idTosessions", fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clubMember ClubMember @relation(fields: [uploadedBy, clubId], references: [id, clubId], onDelete: NoAction, onUpdate: NoAction)
  sessions   Session[]  @relation("sessions_book_idTobooks")

  @@map("books")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ClubMember {
  isAdmin   Boolean   @default(false) @map("is_admin")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  id        String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId    String    @map("club_id") @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  books     Book[]
  comments  Comment[]

  club    Club    @relation(fields: [clubId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([id, clubId])
  @@unique(fields: [profileId, clubId], name: "userByProfile")
  @@map("club_members")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Club {
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  title       String
  description String?
  isPublic    Boolean      @default(false) @map("is_public")
  creatorId   String       @map("creator_id") @db.Uuid
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId    String[]     @map("thread_id") @db.Uuid
  books       Book[]
  clubMembers ClubMember[]
  comments    Comment[]
  sessions    Session[]
  threads     Thread[]

  creatorProfile Profile @relation(fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "clubs_creator_id_fkey1")

  @@map("clubs")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Comment {
  commentText  String    @map("comment_text")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubMemberId String    @map("club_member_id") @db.Uuid
  sessionId    String?   @map("session_id") @db.Uuid
  threadId     String    @map("thread_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  depth        Int       @default(0)
  clubId       String    @map("club_id") @db.Uuid

  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubMember ClubMember @relation(fields: [clubMemberId, clubId], references: [id, clubId], onDelete: NoAction, onUpdate: NoAction)
  session    Session?   @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  thread     Thread     @relation(fields: [threadId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_thread_id")

  @@map("comments")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Profile {
  username    String?      @unique
  avatarUrl   String?      @map("avatar_url")
  id          String       @id @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  email       String?      @db.VarChar
  clubMembers ClubMember[]
  clubs       Club[]

  userReadingSession UserSessionProgress[] @relation(map: "fk_profile_id")
  annotation         Annotation[]          @relation(map: "fk_profile_id")

  @@map("profiles")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Session {
  title     String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookId    String?   @map("book_id") @db.Uuid
  clubId    String    @map("club_id") @db.Uuid
  comments  Comment[]
  threads   Thread[]

  books              Book[]                @relation("books_session_idTosessions")
  book               Book?                 @relation("sessions_book_idTobooks", fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club               Club                  @relation(fields: [clubId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userReadingSession UserSessionProgress[] @relation(map: "fk_session_id")
  annotation         Annotation[]          @relation(map: "fk_session_id")

  @@map("sessions")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Thread {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String     @db.VarChar
  description String?    @db.VarChar
  isLocked    Boolean?   @default(false) @map("is_locked")
  clubId      String?    @map("club_id") @db.Uuid
  sessionId   String?    @map("session_id") @db.Uuid
  type        ThreadType
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?  @default(now()) @map("updated_at") @db.Timestamptz(6)
  comments    Comment[]

  club    Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_club_id")
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_id")

  @@map("threads")
}

enum ThreadType {
  GENERAL
  SESSION

  @@map("threadtype")
}

model UserSessionProgress {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastCFI   String   @map("last_cfi")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profile_id")
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_id")

  @@unique([profileId, sessionId])
  @@map("user_session_progress")
}

model Annotation {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String         @map("profile_id") @db.Uuid
  sessionId String         @map("session_id") @db.Uuid
  cfiRange  String         @map("cfi_range")
  isPublic  Boolean?       @default(false) @map("is_public")
  noteText  String?        @map("note_text")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime?      @default(now()) @map("updated_at") @db.Timestamptz(6)
  type      AnnotationType

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profile_id")
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_id")

  @@map("annotations")
}

enum AnnotationType {
  HIGHLIGHT
  NOTE

  @@map("annotationType")
}
