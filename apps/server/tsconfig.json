{
  "extends": "@shelfmates/tsconfig/base",
  "compilerOptions": {
    "target": "es2020",
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*", "../*"],
    }
  },
  "exclude": ["node_modules", "dist"],
  "references": [{"path": "../../packages/db"}]
}
